# 环境变量模板：复制为 .env 后填写真实值（.env 已被 git 忽略，禁止提交）
#   cp .env.example .env

LOG_CONSOLE_ENABLE=true
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=true
LOG_FILE_LEVEL=INFO
LOG_FILE_RETENTION=7 days
MINERU_API_TOKEN=<your-mineru-token>
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_MAX_FILE_MB=200
MINERU_POLL_INTERVAL=5
MINERU_TIMEOUT=600
OPENAI_API_KEY=<your-key>
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
VL_MODEL=qwen-vl-max
LLM_DEFAULT_MODEL=qwen-plus
VL_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
VL_API_KEY=<your-key>
LLM_DEFAULT_TEMPERATURE=0.3
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=kbadmin
MINIO_SECRET_KEY=<your-minio-secret>
MINIO_BUCKET_NAME=knowledge-base
MINIO_IMG_DIR=images
MINIO_PRESIGNED_EXPIRY=3600
MILVUS_URL=http://127.0.0.1:19530
CHUNKS_COLLECTION=kb_chunks
ENTITY_NAME_COLLECTION=kb_entity_names
ITEM_NAME_COLLECTION=kb_item_names
BGE_M3_PATH=D:/ai_models/modelscope_cache/models/BAAI/bge-m3
BGE_M3=/ai_models/modelscope_cache/models/BAAI/bge-m3
BGE_DEVICE=cuda
BGE_FP16=true
BGE_RERANKER_LARGE=D:/ai_models/modelscope_cache/models/rerank/BAAI/bge-reranker-large
BGE_RERANKER_DEVICE=cuda
BGE_RERANKER_FP16=true
MONGO_URL=mongodb://admin:<strong-random-password>@127.0.0.1:27018/?authSource=admin
MONGO_ROOT_PASSWORD=<strong-random-password>
MONGO_DB_NAME=knowledge_base
MCP_DASHSCOPE_BASE_URL_STREAMABLE=https://dashscope.aliyuncs.com/api/v1/mcps
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
MCP_DASHSCOPE_API_KEY=<your-key>
WRITE_API_KEY=<strong-random-password>

# ---------- 租户隔离（与电商运营助手合并部署时才需要） ----------
# 独立本机使用（python main.py + import.html / chat.html）：保持 false 或留空，
#   请求不带令牌也能用，一律落到 local 租户，行为与合并前完全一致。
# 合并部署：必须 true，并且这里的 KB_INTERNAL_SECRET 要与电商侧 api/.env 的同名
#   变量逐字一致；不一致或缺配置时 /upload、/query、/status、/history 会一律
#   401/503 —— 这是刻意的失败关闭，不要为了"先用起来"把它关掉。
KB_REQUIRE_TENANT=false
KB_INTERNAL_SECRET=
